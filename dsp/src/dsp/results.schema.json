{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanket results",
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null when candidates are ranked without a calibrated probability.",
          "title": "Confidence"
        }
      },
      "required": [
        "value",
        "confidence"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "Assumptions": {
      "additionalProperties": false,
      "description": "What the analysis took as given about the recording; every result and export carries it.\n\nEach entry is stated even when it is UNKNOWN, so nothing about the input is silently defaulted.",
      "properties": {
        "datatype": {
          "$ref": "#/$defs/Parameter",
          "description": "Sample format as a SigMF core:datatype, or ri24_le/ci24_le (and _be) for 24-bit integer PCM, which SigMF can't express."
        },
        "dataOffset": {
          "$ref": "#/$defs/Parameter",
          "description": "Byte offset of the first sample in the data file."
        },
        "sampleRate": {
          "$ref": "#/$defs/Parameter"
        },
        "centerFrequency": {
          "$ref": "#/$defs/Parameter"
        },
        "iqOrder": {
          "anyOf": [
            {
              "$ref": "#/$defs/Parameter"
            },
            {
              "type": "null"
            }
          ],
          "description": "'IQ' or 'QI'. Null only when the datatype is a known real-valued format."
        }
      },
      "required": [
        "datatype",
        "dataOffset",
        "sampleRate",
        "centerFrequency",
        "iqOrder"
      ],
      "title": "Assumptions",
      "type": "object"
    },
    "CatalogueVersion": {
      "additionalProperties": false,
      "description": "A rule set the analysis ran with, versioned apart from the program (PLAN §7).",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "CatalogueVersion",
      "type": "object"
    },
    "EvidenceLevel": {
      "enum": [
        "VERIFIED",
        "MEASURED",
        "ESTIMATED",
        "HYPOTHESIS",
        "UNKNOWN"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "FileIdentity": {
      "additionalProperties": false,
      "description": "One file the recording is read from, by name (never a path) and content.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "sizeBytes": {
          "minimum": 0,
          "title": "Sizebytes",
          "type": "integer"
        },
        "sha256": {
          "description": "Lower-case hex SHA-256 of the file.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sizeBytes",
        "sha256"
      ],
      "title": "FileIdentity",
      "type": "object"
    },
    "Frame": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "startBit": {
          "description": "Offset of the sync word in the decoded bit stream.",
          "minimum": 0,
          "title": "Startbit",
          "type": "integer"
        },
        "syncWord": {
          "minLength": 1,
          "title": "Syncword",
          "type": "string"
        },
        "lengthBits": {
          "minimum": 0,
          "title": "Lengthbits",
          "type": "integer"
        },
        "crc": {
          "enum": [
            "pass",
            "fail",
            "truncated"
          ],
          "title": "Crc",
          "type": "string"
        },
        "headerHex": {
          "description": "The first bytes after the sync word, space-separated.",
          "title": "Headerhex",
          "type": "string"
        },
        "payloadHex": {
          "description": "The frame's payload bytes (CRC excluded), no spaces.",
          "title": "Payloadhex",
          "type": "string"
        }
      },
      "required": [
        "index",
        "startBit",
        "syncWord",
        "lengthBits",
        "crc",
        "headerHex",
        "payloadHex"
      ],
      "title": "Frame",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "description": "One row of the ledger: a candidate the search tried, and what decided it.",
      "properties": {
        "layer": {
          "enum": [
            "Demod",
            "Interleaver",
            "FEC",
            "Framing",
            "Match"
          ],
          "title": "Layer",
          "type": "string"
        },
        "candidate": {
          "minLength": 1,
          "title": "Candidate",
          "type": "string"
        },
        "statistic": {
          "minLength": 1,
          "title": "Statistic",
          "type": "string"
        },
        "pValue": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Chance of the statistic under the no-structure null; null when not computed.",
          "title": "Pvalue"
        },
        "threshold": {
          "description": "The corrected acceptance threshold on p_value.",
          "title": "Threshold",
          "type": "number"
        },
        "outcome": {
          "enum": [
            "accepted",
            "rejected"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "layer",
        "candidate",
        "statistic",
        "pValue",
        "threshold",
        "outcome",
        "reason"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "HypothesisSearch": {
      "additionalProperties": false,
      "description": "The blind search's ledger. `tried` counts every hypothesis, including ones not listed in\n`rows`; thresholds are corrected for that count.",
      "properties": {
        "tried": {
          "minimum": 0,
          "title": "Tried",
          "type": "integer"
        },
        "alpha": {
          "title": "Alpha",
          "type": "number"
        },
        "correction": {
          "minLength": 1,
          "title": "Correction",
          "type": "string"
        },
        "smallestThreshold": {
          "title": "Smallestthreshold",
          "type": "number"
        },
        "shuffledRuns": {
          "description": "Runs on shuffled bits of the chains that passed the threshold, best first (up to three of them, each run several times).",
          "minimum": 0,
          "title": "Shuffledruns",
          "type": "integer"
        },
        "shuffledAccepts": {
          "description": "How many of those runs passed; should be 0.",
          "minimum": 0,
          "title": "Shuffledaccepts",
          "type": "integer"
        },
        "shuffledBlocked": {
          "default": 0,
          "description": "Chains that passed the threshold but also passed on shuffled bits, and so were not accepted.",
          "minimum": 0,
          "title": "Shuffledblocked",
          "type": "integer"
        },
        "blindSearched": {
          "default": 0,
          "description": "Branches the blind rate-1/n convolutional search ran on.",
          "minimum": 0,
          "title": "Blindsearched",
          "type": "integer"
        },
        "blindIdentified": {
          "default": 0,
          "description": "Of those, branches where it named a code (which then still had to frame).",
          "minimum": 0,
          "title": "Blindidentified",
          "type": "integer"
        },
        "matchTried": {
          "default": 0,
          "description": "Known-system checks the Match stage ran, each one hypothesis in its own Holm correction (rows with layer Match), separate from `tried`.",
          "minimum": 0,
          "title": "Matchtried",
          "type": "integer"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/Hypothesis"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "tried",
        "alpha",
        "correction",
        "smallestThreshold",
        "shuffledRuns",
        "shuffledAccepts",
        "shuffledBlocked",
        "blindSearched",
        "blindIdentified",
        "matchTried",
        "rows"
      ],
      "title": "HypothesisSearch",
      "type": "object"
    },
    "Parameter": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          },
          "if": {
            "properties": {
              "level": {
                "const": "UNKNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "evidence": {
                "minItems": 1
              },
              "resolveHint": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "ESTIMATED"
              },
              "value": {
                "type": "number"
              }
            }
          },
          "then": {
            "properties": {
              "uncertainty": {
                "type": "number"
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "proof": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "level": {
                "const": "VERIFIED"
              }
            }
          },
          "then": {
            "properties": {
              "proof": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "convention": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "level": {
                "const": "HYPOTHESIS"
              }
            }
          }
        }
      ],
      "description": "A reported value with its evidence level, method and evidence.\n\nUNKNOWN has no value and states why and what would settle it; an ESTIMATED number carries\nits uncertainty; VERIFIED, and only VERIFIED, carries a CRC, sync-recurrence or re-encode proof.\nA value the evidence can't decide, taken on a stated convention instead, is a HYPOTHESIS that\nnames the convention; results list every such value under needsReview.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "uncertainty": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Standard uncertainty (1 sigma), in the value's unit.",
          "title": "Uncertainty"
        },
        "level": {
          "$ref": "#/$defs/EvidenceLevel"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "alternatives": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "resolveHint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For UNKNOWN: what additional input would settle it.",
          "title": "Resolvehint"
        },
        "proof": {
          "anyOf": [
            {
              "$ref": "#/$defs/Proof"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "convention": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when the evidence can't decide and the value follows a stated convention instead: the convention and why an analyst should review it. Only on HYPOTHESIS.",
          "title": "Convention"
        }
      },
      "required": [
        "id",
        "name",
        "value",
        "unit",
        "uncertainty",
        "level",
        "confidence",
        "method",
        "evidence",
        "alternatives",
        "warnings",
        "resolveHint",
        "proof",
        "convention"
      ],
      "title": "Parameter",
      "type": "object"
    },
    "Proof": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "crc",
            "sync_recurrence",
            "reencode"
          ],
          "title": "Kind",
          "type": "string"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "detail"
      ],
      "title": "Proof",
      "type": "object"
    },
    "RecordingIdentity": {
      "additionalProperties": false,
      "description": "What was analysed, tied to the exact bytes: the container and sample count, and every file\nthe samples and their metadata come from (a SigMF recording's metadata and dataset, a\nnumbered sequence's files), sorted by name.",
      "properties": {
        "container": {
          "minLength": 1,
          "title": "Container",
          "type": "string"
        },
        "samples": {
          "minimum": 0,
          "title": "Samples",
          "type": "integer"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/FileIdentity"
          },
          "title": "Files",
          "type": "array"
        }
      },
      "required": [
        "container",
        "samples",
        "files"
      ],
      "title": "RecordingIdentity",
      "type": "object"
    },
    "ReviewItem": {
      "additionalProperties": false,
      "description": "A value taken on a convention rather than evidence, for the analyst to confirm.",
      "properties": {
        "signal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The signal it belongs to; null for an assumption or a whole-recording stage.",
          "title": "Signal"
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The stage that reported it; null for an assumption.",
          "title": "Stage"
        },
        "parameter": {
          "description": "The parameter's id.",
          "title": "Parameter",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "convention": {
          "title": "Convention",
          "type": "string"
        }
      },
      "required": [
        "signal",
        "stage",
        "parameter",
        "name",
        "value",
        "convention"
      ],
      "title": "ReviewItem",
      "type": "object"
    },
    "Signal": {
      "additionalProperties": false,
      "description": "One detected signal (PLAN §3): its own stage results, kept apart from the\nwhole-recording stages above (`Results.stages`) because a recording can hold several,\nand what they add up to: the label, the headline and its level, the hypothesis ledger and the\nframe table (`SignalFindings`). The constellation and the eye are for the live views and are\nnot part of the document.",
      "properties": {
        "label": {
          "description": "Short label for the signal, e.g. 'QPSK'.",
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "description": "Picks the symbol view: constellation, frequency, none.",
          "enum": [
            "psk",
            "fsk",
            "cw",
            "analog",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/EvidenceLevel",
          "description": "The level of the signal's headline finding."
        },
        "headline": {
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "search": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisSearch"
            },
            {
              "type": "null"
            }
          ],
          "description": "The hypothesis ledger; null when no search ran, and `noSearchReason` says why."
        },
        "noSearchReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nosearchreason"
        },
        "frames": {
          "default": [],
          "description": "The frame table, limited to the first 500 frames.",
          "items": {
            "$ref": "#/$defs/Frame"
          },
          "maxItems": 500,
          "title": "Frames",
          "type": "array"
        },
        "noFramesReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Noframesreason"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/StageResult"
          },
          "title": "Stages",
          "type": "array"
        }
      },
      "required": [
        "label",
        "kind",
        "level",
        "headline",
        "search",
        "noSearchReason",
        "frames",
        "noFramesReason",
        "id",
        "stages"
      ],
      "title": "Signal",
      "type": "object"
    },
    "StageResult": {
      "additionalProperties": false,
      "description": "One stage's output. A stage that throws is FAILED with its error; the job carries on.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "done",
            "not-applicable",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "parameters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Parameter"
          },
          "title": "Parameters",
          "type": "array"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Present exactly when status is failed.",
          "title": "Error"
        }
      },
      "required": [
        "id",
        "name",
        "status",
        "summary",
        "parameters",
        "warnings",
        "error"
      ],
      "title": "StageResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The results of analysing one recording.\n\n`needsReview` is derived from the parameters, never set by hand: it lists every value taken\non a convention, so one field tells a reader or a script whether anything rests on a guess.",
  "properties": {
    "schemaVersion": {
      "const": "0.6.0",
      "default": "0.6.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "sanketVersion": {
      "minLength": 1,
      "title": "Sanketversion",
      "type": "string"
    },
    "recording": {
      "$ref": "#/$defs/RecordingIdentity"
    },
    "catalogues": {
      "items": {
        "$ref": "#/$defs/CatalogueVersion"
      },
      "title": "Catalogues",
      "type": "array"
    },
    "assumptions": {
      "$ref": "#/$defs/Assumptions"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageResult"
      },
      "title": "Stages",
      "type": "array"
    },
    "signals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Signal"
      },
      "title": "Signals",
      "type": "array"
    },
    "needsReview": {
      "description": "Every value taken on a convention rather than evidence, derived from the parameters. Empty when nothing rests on a convention.",
      "items": {
        "$ref": "#/$defs/ReviewItem"
      },
      "readOnly": true,
      "title": "Needsreview",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "sanketVersion",
    "recording",
    "catalogues",
    "assumptions",
    "stages",
    "signals",
    "needsReview"
  ],
  "type": "object"
}
